# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Amazon Advertising API Configuration
# Amazon DSP API credentials for invoice extraction
REFRESH_TOKEN_AMZ_API=your-amazon-refresh-token-here
CLIENT_ID_AMAZON=amzn1.application-oa2-client.your-client-id-here
SECRET_CLIENT_AMAZON=your-amazon-client-secret-here

# Amazon API Endpoints - US Region
API_US_URL_AMAZON=https://advertising-api.amazon.com
TOKEN_US_URL_AMAZON=https://api.amazon.com/auth/o2/token

# Amazon API Endpoints - EU Region
API_EU_URL_AMAZON=https://advertising-api-eu.amazon.com
TOKEN_EU_URL_AMAZON=https://api.amazon.co.uk/auth/o2/token

# Optional: Google Gemini API (for fallback AI extraction)
# GOOGLE_API_KEY=your-gemini-api-key-here
